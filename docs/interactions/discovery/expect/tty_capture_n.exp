#!/usr/bin/expect -f

# tty_capture_n.exp runs a command in a pseudo TTY, captures output, then sends "n" and Enter.
#
# Usage:
#   expect tty_capture_n.exp <cwd> <output_file> <seconds> <rows> <cols> <cmd> [args...]

set timeout 1
match_max 20000
log_user 1

if {[llength $argv] < 6} {
  puts "usage: tty_capture_n.exp <cwd> <output_file> <seconds> <rows> <cols> <cmd> [args...]"
  exit 2
}

set cwd [lindex $argv 0]
set output_file [lindex $argv 1]
set seconds [lindex $argv 2]
set rows [lindex $argv 3]
set cols [lindex $argv 4]
set cmd [lrange $argv 5 end]

cd $cwd
set env(TERM) "xterm-256color"

file delete -force $output_file
log_file -noappend $output_file

spawn -noecho {*}$cmd

set done 0
set timed_out 0
set exited 0
set answered 0
after [expr {int($seconds) * 1000}] { set done 1 ; set timed_out 1 }

# Best effort early answer in case the prompt arrives before we can pattern match.
after 400 { catch {send -- "n\r"} }

while {!$done} {
  set expect_err [catch {
    expect {
      -re {Overwrite\\?} {
        if {!$answered} {
          set answered 1
          send -- "n\r"
        }
        exp_continue
      }
      -re {Do you want to delete these files\\?} {
        if {!$answered} {
          set answered 1
          send -- "n\r"
        }
        exp_continue
      }
      -re {\\(y/N\\):} {
        if {!$answered} {
          set answered 1
          send -- "n\r"
        }
        exp_continue
      }
      -re "\033\\[6n" {
        send -- "\033\[1;1R"
        exp_continue
      }
      -re "\033\\]11;\\?\033\\\\" {
        send -- "\033\]11;rgb:0000/0000/0000\033\\"
        exp_continue
      }
      -re {(.|\\n)+} {}
      eof { set done 1 ; set exited 1 }
      timeout {}
    }
  } expect_msg]

  if {$expect_err != 0} {
    set done 1
    set exited 1
  }
}

log_file

if {$timed_out && !$exited} {
  send -- "\003"
  after 200
  catch {exec kill -KILL [exp_pid -i $spawn_id]}
  catch {close -i $spawn_id}
  catch {wait -i $spawn_id}
  exit 124
}

set exit_code 0
catch {
  catch {close -i $spawn_id}
  set wait_result [wait -i $spawn_id]
  set wait_status [lindex $wait_result 3]
  if {[llength $wait_status] == 1 && [string is integer -strict $wait_status]} {
    set exit_code $wait_status
  } elseif {[llength $wait_status] >= 3 && [lindex $wait_status 0] == "CHILDSTATUS"} {
    set exit_code [lindex $wait_status 2]
  } elseif {[llength $wait_status] >= 3 && [lindex $wait_status 0] == "CHILDKILLED"} {
    set exit_code [expr {128 + [lindex $wait_status 2]}]
  } else {
    set exit_code 1
  }
} wait_err

exit $exit_code
