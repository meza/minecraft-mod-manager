#!/usr/bin/expect -f

# tty_capture.exp runs a command in a pseudo TTY and captures output.
#
# Usage:
#   expect tty_capture.exp <cwd> <output_file> <seconds> <rows> <cols> <cmd> [args...]
#
# Notes:
# - This wrapper is intended for discovery captures, not reliable automation.
# - It replies to common terminal probes seen in Bubble Tea programs.

set timeout 1
match_max 20000
log_user 1

if {[llength $argv] < 6} {
  puts "usage: tty_capture.exp <cwd> <output_file> <seconds> <rows> <cols> <cmd> [args...]"
  exit 2
}

set cwd [lindex $argv 0]
set output_file [lindex $argv 1]
set seconds [lindex $argv 2]
set rows [lindex $argv 3]
set cols [lindex $argv 4]
set cmd [lrange $argv 5 end]

cd $cwd
set env(TERM) "xterm-256color"

file delete -force $output_file
log_file -noappend $output_file

spawn -noecho {*}$cmd
# Do not call stty here.
# In this harness environment stty can cause the expect process to hang.

set done 0
set timed_out 0
set exited 0
after [expr {int($seconds) * 1000}] { set done 1 ; set timed_out 1 }

while {!$done} {
  set expect_err [catch {
    expect {
      # Device status report, cursor position.
      -re "\033\\[6n" {
        send -- "\033\[1;1R"
        exp_continue
      }

      # OSC background color query (seen in some environments).
      -re "\033\\]11;\\?\033\\\\" {
        send -- "\033\]11;rgb:0000/0000/0000\033\\"
        exp_continue
      }

      # Generic output drain.
      -re {(.|\\n)+} {
        # Do not exp_continue here. Returning gives timers a chance to fire.
      }

      eof {
        set done 1
        set exited 1
      }

      timeout {}
    }
  } expect_msg]

  if {$expect_err != 0} {
    # If the spawn id is already closed, treat this as exited.
    set done 1
    set exited 1
  }
}

log_file

if {$timed_out && !$exited} {
  # Best effort shutdown so we do not hang.
  send -- "\\003"
  after 200
  catch {exec kill -KILL [exp_pid -i $spawn_id]}
  catch {close -i $spawn_id}
  catch {wait -i $spawn_id}
  exit 124
}

set exit_code 0
catch {
  catch {close -i $spawn_id}
  set wait_result [wait -i $spawn_id]
  set wait_status [lindex $wait_result 3]
  if {[llength $wait_status] == 1 && [string is integer -strict $wait_status]} {
    set exit_code $wait_status
  } elseif {[llength $wait_status] >= 3 && [lindex $wait_status 0] == "CHILDSTATUS"} {
    set exit_code [lindex $wait_status 2]
  } elseif {[llength $wait_status] >= 3 && [lindex $wait_status 0] == "CHILDKILLED"} {
    set exit_code [expr {128 + [lindex $wait_status 2]}]
  } else {
    set exit_code 1
  }
} wait_err

exit $exit_code
